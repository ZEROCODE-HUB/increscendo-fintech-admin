# Supabase de Increscendo (el mismo proyecto que usa la plataforma del cliente).
# Sin estas dos variables el panel abre en "modo demostración" con datos de ejemplo.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# API de Increscendo (Belvo, SignNow, Conekta, Tekae). Por defecto: https://increscendo-api.vercel.app
VITE_INCRESCENDO_API_URL=https://increscendo-api.vercel.app

# App del cliente: los correos enlazan aquí (no al admin).
VITE_CLIENT_APP_URL=https://increscendofintech.com

# Bucket de Supabase Storage donde viven INE, CURP, contratos y vouchers.
VITE_STORAGE_BUCKET=documents
